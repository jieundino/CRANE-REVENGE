# CRANE REVENGE 환경 변수 예시 파일
# 실제 사용 시 이 파일을 .env 로 복사하여 환경에 맞게 수정하세요.
# 주의: .env 파일과 실제 비밀값은 Git에 커밋하지 않습니다.

# Streamlit 프론트엔드가 호출할 FastAPI 백엔드 주소
API_BASE_URL=http://127.0.0.1:8000

# SQLite 데이터베이스 파일 저장 경로
DATABASE_PATH=./data/crane_revenge.db

# 실행 환경 구분 (development / production)
APP_ENV=development
